{
  "$comment": "OGR local-redaction conformance corpus (specification/local-redaction.md). The ruleset is three rules copied verbatim from the AIRS catalog (policy-engine/entities.ts, 2026-08-28) — one with `group`. Every implementation of mask()/restore(), in any engine, runs these cases; mask cases start a fresh session and feed `steps` in order, expecting `expect[i]` per step and, when given, `values` as the session map afterwards.",
  "ruleset": {
    "id": "rs_conformance000000000000000000001",
    "generated_at": "2026-08-28T00:00:00Z",
    "family": "secrets",
    "dialect": "ogr-re-1",
    "rules": [
      {
        "id": "entity_api_key",
        "category": "security.secret_leak.api_key",
        "severity": "critical",
        "tier": "strong",
        "flags": "",
        "patterns": [
          {
            "id": "openai",
            "source": "(?<![A-Za-z0-9])sk-(?:proj-)?[A-Za-z0-9_\\-]{20,}(?![A-Za-z0-9])"
          },
          {
            "id": "github",
            "source": "(?<![A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{36}(?![A-Za-z0-9])"
          },
          {
            "id": "stripe_secret",
            "source": "(?<![A-Za-z0-9])(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{20,}(?![A-Za-z0-9])"
          }
        ],
        "examples": {
          "match": [
            "sk-proj-abcdefghijklmnopqrstuvwxyz0123456789",
            "ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij",
            "sk-proj-Zx8Q1pLm9aQvR2tYwB7nK4sDefgh"
          ],
          "nomatch": [
            "sk-${OPENAI_API_KEY}",
            "ghp_short",
            "sk-...3ab",
            "pk_live_abcdefghijklmnopqrstuvwxyz"
          ]
        }
      },
      {
        "id": "entity_bearer_token",
        "category": "security.secret_leak.api_key",
        "severity": "critical",
        "tier": "strong",
        "flags": "i",
        "patterns": [
          {
            "id": "authorization_header",
            "source": "(?<![A-Za-z0-9\\-])(?:proxy-)?authorization\\s*:\\s*(?:bearer|basic|token|apikey)\\s{1,4}(?!(?:\\*{3,}|x{3,}|\\$\\{|<|>|%[sd]|\\.{3,}|…|changeme|placeholder|redacted|your[_\\-]?password|your[_\\-]|example|token(?![A-Za-z0-9_])|secret(?![A-Za-z0-9_])|\\$))(?![A-Za-z0-9._~+/\\-]*(?:\\.{3,}|…))([A-Za-z0-9._~+/\\-]{12,}={0,2})"
          }
        ],
        "group": 1,
        "examples": {
          "match": [
            "curl -H \"Authorization: Bearer pk_cc7f7b3f73664638b8f30fe8ca598848\"",
            "Proxy-Authorization: Basic dXNlcjpwYXNzd29yZDEyMw=="
          ],
          "nomatch": [
            "Authorization: Bearer <YOUR_TOKEN>",
            "Authorization: Bearer ${API_TOKEN}",
            "Authorization: Bearer $TOKEN",
            "Authorization: Bearer pk_cc7...8848",
            "Authorization: Bearer xxxxxxxxxxxxxxxx"
          ]
        }
      },
      {
        "id": "entity_aws_key_id",
        "category": "security.secret_leak.cloud_credential",
        "severity": "critical",
        "tier": "strong",
        "flags": "",
        "patterns": [
          {
            "id": "aws_access_key_id",
            "source": "(?<![A-Z0-9])(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA|AIPA)[A-Z0-9]{16}(?![A-Z0-9])"
          }
        ],
        "examples": {
          "match": [
            "AKIAIOSFODNN7EXAMPLE",
            "key AROAJ6WCMLZ3PQ4G7DYX in"
          ],
          "nomatch": [
            "akiaiosfodnn7example",
            "AKIA1234",
            "XAKIAIOSFODNN7EXAMPLE"
          ]
        }
      }
    ]
  },
  "cases": {
    "mask": [
      {
        "name": "an issuer-prefixed key is replaced by a numbered token and reported as rule/pattern",
        "steps": [
          "use sk-proj-abcdefghijklmnopqrstuvwxyz0123456789 now"
        ],
        "expect": [
          {
            "text": "use OGRKP0000001 now",
            "minted": [
              {
                "token": "OGRKP0000001",
                "rule": "entity_api_key/openai"
              }
            ]
          }
        ],
        "values": {
          "OGRKP0000001": "sk-proj-abcdefghijklmnopqrstuvwxyz0123456789"
        }
      },
      {
        "name": "a group names the span: the credential goes, the header stays",
        "steps": [
          "curl -H \"Authorization: Bearer pk_cc7f7b3f73664638b8f30fe8ca598848\" https://api.example.com"
        ],
        "expect": [
          {
            "text": "curl -H \"Authorization: Bearer OGRKP0000001\" https://api.example.com",
            "minted": [
              {
                "token": "OGRKP0000001",
                "rule": "entity_bearer_token/authorization_header"
              }
            ]
          }
        ]
      },
      {
        "name": "a value is stable across steps; only new values are minted",
        "steps": [
          "key AKIAIOSFODNN7EXAMPLE",
          "again AKIAIOSFODNN7EXAMPLE and sk-proj-abcdefghijklmnopqrstuvwxyz0123456789",
          "AKIAIOSFODNN7EXAMPLE"
        ],
        "expect": [
          {
            "text": "key OGRKP0000001",
            "minted": [
              {
                "token": "OGRKP0000001",
                "rule": "entity_aws_key_id/aws_access_key_id"
              }
            ]
          },
          {
            "text": "again OGRKP0000001 and OGRKP0000002",
            "minted": [
              {
                "token": "OGRKP0000002",
                "rule": "entity_api_key/openai"
              }
            ]
          },
          {
            "text": "OGRKP0000001",
            "minted": []
          }
        ],
        "values": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE",
          "OGRKP0000002": "sk-proj-abcdefghijklmnopqrstuvwxyz0123456789"
        }
      },
      {
        "name": "nothing is ever matched inside an existing placeholder",
        "steps": [
          "token ${OGR_SECRET_9} and ${OGR_PHONE_2} stay; AKIAIOSFODNN7EXAMPLE goes"
        ],
        "expect": [
          {
            "text": "token ${OGR_SECRET_9} and ${OGR_PHONE_2} stay; OGRKP0000001 goes",
            "minted": [
              {
                "token": "OGRKP0000001",
                "rule": "entity_aws_key_id/aws_access_key_id"
              }
            ]
          }
        ]
      },
      {
        "name": "a value split by a zero-width space is still one value, and the splice removes the splitter",
        "steps": [
          "AKIAIOSFODNN7​EXAMPLE",
          "AKIAIOSFODNN7EXAMPLE"
        ],
        "expect": [
          {
            "text": "OGRKP0000001",
            "minted": [
              {
                "token": "OGRKP0000001",
                "rule": "entity_aws_key_id/aws_access_key_id"
              }
            ]
          },
          {
            "text": "OGRKP0000001",
            "minted": []
          }
        ],
        "values": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        }
      },
      {
        "name": "overlap: longest wins — the bearer group's longer span beats the exact-length github key",
        "steps": [
          "Authorization: Bearer ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij.extra"
        ],
        "expect": [
          {
            "text": "Authorization: Bearer OGRKP0000001",
            "minted": [
              {
                "token": "OGRKP0000001",
                "rule": "entity_bearer_token/authorization_header"
              }
            ]
          }
        ],
        "values": {
          "OGRKP0000001": "ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij.extra"
        }
      },
      {
        "name": "overlap: equal length falls to served order — api_key is listed before bearer_token",
        "steps": [
          "Authorization: Bearer sk-proj-Zx8Q1pLm9aQvR2tYwB7nK4sDefgh"
        ],
        "expect": [
          {
            "text": "Authorization: Bearer OGRKP0000001",
            "minted": [
              {
                "token": "OGRKP0000001",
                "rule": "entity_api_key/openai"
              }
            ]
          }
        ]
      },
      {
        "name": "a known value is replaced wherever it recurs, even where no rule would match it",
        "steps": [
          "sk-proj-Zx8Q1pLm9aQvR2tYwB7nK4sDefgh",
          "prefix-sk-proj-Zx8Q1pLm9aQvR2tYwB7nK4sDefghsuffix"
        ],
        "expect": [
          {
            "text": "OGRKP0000001",
            "minted": [
              {
                "token": "OGRKP0000001",
                "rule": "entity_api_key/openai"
              }
            ]
          },
          {
            "text": "prefix-OGRKP0000001suffix",
            "minted": []
          }
        ]
      },
      {
        "name": "two values in one text are numbered left to right",
        "steps": [
          "a=AKIAIOSFODNN7EXAMPLE b=AROAJ6WCMLZ3PQ4G7DYX"
        ],
        "expect": [
          {
            "text": "a=OGRKP0000001 b=OGRKP0000002",
            "minted": [
              {
                "token": "OGRKP0000001",
                "rule": "entity_aws_key_id/aws_access_key_id"
              },
              {
                "token": "OGRKP0000002",
                "rule": "entity_aws_key_id/aws_access_key_id"
              }
            ]
          }
        ]
      },
      {
        "name": "a nomatch example shape is left alone",
        "steps": [
          "Authorization: Bearer ${API_TOKEN} and pk_live_abcdefghijklmnopqrstuvwxyz"
        ],
        "expect": [
          {
            "text": "Authorization: Bearer ${API_TOKEN} and pk_live_abcdefghijklmnopqrstuvwxyz",
            "minted": []
          }
        ]
      }
    ],
    "restore": [
      {
        "name": "a whole token restores",
        "map": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        },
        "input": "aws s3 ls --key OGRKP0000001 --region us-east-1",
        "expect": {
          "text": "aws s3 ls --key AKIAIOSFODNN7EXAMPLE --region us-east-1",
          "unresolved": []
        }
      },
      {
        "name": "a markdown-escaped token restores",
        "map": {
          "${OGR_SECRET_1}": "AKIAIOSFODNN7EXAMPLE"
        },
        "input": "key=${OGR\\_SECRET\\_1}",
        "expect": {
          "text": "key=AKIAIOSFODNN7EXAMPLE",
          "unresolved": []
        }
      },
      {
        "name": "a fully escaped token restores",
        "map": {
          "${OGR_SECRET_1}": "AKIAIOSFODNN7EXAMPLE"
        },
        "input": "\\$\\{OGR\\_SECRET\\_1\\}",
        "expect": {
          "text": "AKIAIOSFODNN7EXAMPLE",
          "unresolved": []
        }
      },
      {
        "name": "a token this session never issued is reported, never guessed",
        "map": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        },
        "input": "curl -H 'Authorization: Bearer OGRKP0000007'",
        "expect": {
          "text": "curl -H 'Authorization: Bearer OGRKP0000007'",
          "unresolved": [
            "OGRKP0000007"
          ]
        }
      },
      {
        "name": "no prefix matching: OGRKP0000012 is not OGRKP0000001, and fixed width means no key is another's prefix",
        "map": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        },
        "input": "OGRKP0000012",
        "expect": {
          "text": "OGRKP0000012",
          "unresolved": [
            "OGRKP0000012"
          ]
        }
      },
      {
        "name": "the overflow placeholder is by construction unresolved",
        "map": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        },
        "input": "OGRKPXXXXXXX",
        "expect": {
          "text": "OGRKPXXXXXXX",
          "unresolved": [
            "OGRKPXXXXXXX"
          ]
        }
      },
      {
        "name": "an escaped unresolved token is reported in its bare form",
        "map": {},
        "input": "${OGR\\_SECRET\\_3}",
        "expect": {
          "text": "${OGR\\_SECRET\\_3}",
          "unresolved": [
            "${OGR_SECRET_3}"
          ]
        }
      },
      {
        "name": "a backslash before a non-escapable character is literal, so C:\\name never opens a token",
        "map": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        },
        "input": "C:\\name and OGRKP0000001",
        "expect": {
          "text": "C:\\name and AKIAIOSFODNN7EXAMPLE",
          "unresolved": []
        }
      },
      {
        "name": "several tokens, longest key first, each restored exactly once",
        "map": {
          "OGRKP0000001": "one",
          "OGRKP0000010": "ten"
        },
        "input": "OGRKP0000010/OGRKP0000001/OGRKP0000010",
        "expect": {
          "text": "ten/one/ten",
          "unresolved": []
        }
      }
    ],
    "stream": [
      {
        "name": "a token split across three deltas restores once its last piece arrives; nothing is emitted early",
        "map": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        },
        "deltas": [
          "aws --key OGRKP00",
          "0000",
          "1 ls"
        ],
        "expect": [
          "aws --key ",
          "",
          "AKIAIOSFODNN7EXAMPLE ls"
        ],
        "end": ""
      },
      {
        "name": "a partial token at end of stream is text, delivered by the final flush",
        "map": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        },
        "deltas": [
          "cost: O",
          "GRKP000"
        ],
        "expect": [
          "cost: ",
          ""
        ],
        "end": "OGRKP000"
      },
      {
        "name": "a token that completes inside one delta restores in that delta",
        "map": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        },
        "deltas": [
          "key=OGRKP0000001;"
        ],
        "expect": [
          "key=AKIAIOSFODNN7EXAMPLE;"
        ],
        "end": ""
      },
      {
        "name": "a key held across a delta boundary completes as the token it is: OGRKP000001 then 0 is token 10, not token 1 followed by 0",
        "map": {
          "OGRKP0000001": "one",
          "OGRKP0000010": "ten"
        },
        "deltas": [
          "OGRKP000001",
          "0/OGRKP0000001"
        ],
        "expect": [
          "",
          "ten/one"
        ],
        "end": ""
      },
      {
        "name": "a markdown-escaped token split at the escape restores",
        "map": {
          "${OGR_SECRET_1}": "AKIAIOSFODNN7EXAMPLE"
        },
        "deltas": [
          "${OGR\\",
          "_SECRET\\_1}"
        ],
        "expect": [
          "",
          "AKIAIOSFODNN7EXAMPLE"
        ],
        "end": ""
      },
      {
        "name": "a backslash before a non-escapable character never opens a token, streamed or not",
        "map": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        },
        "deltas": [
          "C:\\",
          "name OGRKP0000001"
        ],
        "expect": [
          "C:",
          "\\name AKIAIOSFODNN7EXAMPLE"
        ],
        "end": ""
      },
      {
        "name": "a token this session never issued is passed through as text, never guessed",
        "map": {
          "OGRKP0000001": "AKIAIOSFODNN7EXAMPLE"
        },
        "deltas": [
          "OGRKP000000",
          "7 and OGRKP0000001"
        ],
        "expect": [
          "",
          "OGRKP0000007 and AKIAIOSFODNN7EXAMPLE"
        ],
        "end": ""
      }
    ]
  },
  "minter": "P"
}
