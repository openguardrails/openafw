    "family": "secrets",
    "dialect": "ogr-re-1",
    "rules": [
      {
        "id": "entity_private_key",
        "category": "security.secret_leak.private_key",
        "severity": "critical",
        "tier": "strong",
        "flags": "",
        "patterns": [
          {
            "id": "pem_block",
            "source": "-----BEGIN (?:[A-Z0-9]+ )?PRIVATE KEY(?: BLOCK)?-----[A-Za-z0-9+/=\\s\\\\:,.-]*?-----END (?:[A-Z0-9]+ )?PRIVATE KEY(?: BLOCK)?-----"
          },
          {
            "id": "pem_header",
            "source": "-----BEGIN (?:[A-Z0-9]+ )?PRIVATE KEY(?: BLOCK)?-----(?:[\\r\\n]|\\\\[rn]){1,4}[A-Za-z0-9+/]{4,}"
          }
        ],
        "examples": {
          "match": [
            "-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQ==\n-----END OPENSSH PRIVATE KEY-----",
            "-----BEGIN RSA PRIVATE KEY-----\nMIIEpgIBAAKCAQEA9bjTMIaJpVgtgUwyyK2ayCDq",
            "SSH_KEY = -----BEGIN OPENSSH PRIVATE KEY-----\\nb3BlbnNzaC1rZXktdjEAAAAA"
          ],
          "nomatch": [
            "-----BEGIN CERTIFICATE-----",
            "-----BEGIN PUBLIC KEY-----",
            "fixtures embed a fake `-----BEGIN PRIVATE KEY-----` filler",
            "[]byte(\"-----BEGIN ENCRYPTED PRIVATE KEY-----\\n\" + b64 + \"\\n-----END ENCRYPTED PRIVATE KEY-----\\n\")"
          ]
        }
      },
      {
        "id": "entity_aws_key_id",
        "category": "security.secret_leak.cloud_credential",
        "severity": "critical",
        "tier": "strong",
        "flags": "",
        "patterns": [
          {
            "id": "aws_access_key_id",
            "source": "(?<![A-Z0-9])(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA|AIPA)[A-Z0-9]{16}(?![A-Z0-9])"
          },
          {
            "id": "tencent_secret_id",
            "source": "(?<![A-Za-z0-9])AKID[A-Za-z0-9]{32}(?![A-Za-z0-9])"
          },
          {
            "id": "aliyun_access_key_id",
            "source": "(?<![A-Za-z0-9])LTAI[A-Za-z0-9]{12,20}(?![A-Za-z0-9])"
          },
          {
            "id": "volcengine_access_key_id",
            "source": "(?<![A-Za-z0-9])AKLT[A-Za-z0-9_\\-]{16,}(?![A-Za-z0-9_\\-])"
          }
        ],
        "examples": {
          "match": [
            "AKIAIOSFODNN7EXAMPLE",
            "key AROAJ6WCMLZ3PQ4G7DYX in",
            "BUCKET_SECRET_ID: \"AKIDztmT3TgeNr67tRkyzlIcjbEbAWeaCdpm\"",
            "LTAI5tKpQm9aQvR2tYwB7nK4",
            "AKLTZjRhNWQ2ZTctYmM4Mi00"
          ],
          "nomatch": [
            "akiaiosfodnn7example",
            "AKIA1234",
            "XAKIAIOSFODNN7EXAMPLE",
            "AKID1234",
            "LTAI12"
          ]
        }
      },
